// exe 图标 + 文件属性（右键 → 属性 → 详细信息）
// 由 build.rs 通过 embed-resource 编译，MSVC 走 rc.exe，MinGW 走 windres。
#pragma code_page(65001)

1 ICON "assets/icon.ico"

1 VERSIONINFO
FILEVERSION     0,2,0,0
PRODUCTVERSION  0,2,0,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "choumine"
            VALUE "FileDescription",  "合图 · 多图拼接工具"
            VALUE "FileVersion",      "0.2.0"
            VALUE "InternalName",     "hetu"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "hetu.exe"
            VALUE "ProductName",      "合图"
            VALUE "ProductVersion",   "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
